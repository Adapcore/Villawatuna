@{
    ViewData["Title"] = "Currency Exchange";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;
}

<link rel="stylesheet" href="~/css/currency-exchange-index.css?v=@Configuration["Assets:Version"]" />

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">💱 Currency Exchange</h2>
        <a asp-action="Create" class="btn btn-success btn-add-exchange">
            <i class="bi bi-plus-circle"></i> <span>New Exchange</span>
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form id="exchangeFilterForm" class="row g-3">
                <div class="col-md-2 col-sm-6">
                    <label class="form-label fw-bold">Customer</label>
                    <select name="customerId" id="customerId" class="form-select form-select-sm" asp-items="ViewBag.Customers"></select>
                </div>
                <div class="col-md-2 col-sm-6">
                    <label class="form-label fw-bold">Currency</label>
                    <select name="foreignCurrencyId" id="foreignCurrencyId" class="form-select form-select-sm" asp-items="ViewBag.Currencies"></select>
                </div>
                <div class="col-md-2 col-sm-6">
                    <label class="form-label fw-bold">From Date</label>
                    <input type="date" name="startDate" id="startDate" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2 col-sm-6">
                    <label class="form-label fw-bold">To Date</label>
                    <input type="date" name="endDate" id="endDate" class="form-control form-control-sm" />
                </div>
                <div class="col-md-4 col-12 d-flex align-items-end">
                    <div class="d-flex gap-1 flex-wrap">
                        <button type="button" id="btnToday" class="btn btn-outline-secondary btn-sm">Today</button>
                        <button type="button" id="btnYesterday" class="btn btn-outline-secondary btn-sm">Yesterday</button>
                        <button type="button" id="btnMonth" class="btn btn-outline-secondary btn-sm">Month</button>
                        <button type="button" id="btnYear" class="btn btn-outline-secondary btn-sm">Year</button>
                        <button type="button" id="btnClear" class="btn btn-outline-dark btn-sm">Clear</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div id="exchangeLoadingIndicator" class="text-center py-5" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3">Loading exchanges...</p>
    </div>

    <div class="exchange-table-desktop" id="exchangeTableDesktop">
        <div class="table-responsive shadow-sm">
            <table class="table table-striped table-hover table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Txn No</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Currency</th>
                        <th class="text-end">Rate</th>
                        <th class="text-end">Foreign Amount</th>
                        <th class="text-end">LKR Amount<br /><span>Σ <span id="exchangeTotalLkr">LKR 0.00</span></span></th>
                        <th>Remarks</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody id="exchangeTableBody">
                </tbody>
            </table>
        </div>
    </div>

    <div class="exchange-table-mobile" id="exchangeTableMobile">
    </div>

    <div id="exchangePaginationContainer" class="mt-3"></div>
</div>

@Html.AntiForgeryToken()
<input type="hidden" id="isAdminFlag" data-is-admin="@isAdmin" />

<script src="~/js/currency-exchange-index.js?v=@Configuration["Assets:Version"]"></script>
