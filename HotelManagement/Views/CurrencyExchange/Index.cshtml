@{
    ViewData["Title"] = "Currency Exchange";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;
}

<link rel="stylesheet" href="~/css/currency-exchange-index.css?v=@Configuration["Assets:Version"]" />
<link rel="stylesheet" href="~/css/period-date-filter.css?v=@Configuration["Assets:Version"]" />

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">💱 Currency Exchange</h2>
        <a asp-action="Create" class="btn btn-success btn-add-exchange">
            <i class="bi bi-plus-circle"></i> <span>New Exchange</span>
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form id="exchangeFilterForm">
                <div class="row g-3 align-items-end" id="exchangeDateFilter">
                <div class="col-md-2 col-sm-6">
                    <label class="form-label fw-bold">Customer</label>
                    <select name="customerId" id="customerId" class="form-select form-select-sm" asp-items="ViewBag.Customers"></select>
                </div>
                <div class="col-md-2 col-sm-6">
                    <label class="form-label fw-bold">Currency</label>
                    <select name="foreignCurrency" id="foreignCurrency" class="form-select form-select-sm" asp-items="ViewBag.Currencies"></select>
                </div>
                @{
                    ViewData["pfFromName"] = "startDate";
                    ViewData["pfToName"] = "endDate";
                }
                <partial name="_PeriodDateFilterFields" />
                </div>
            </form>
        </div>
    </div>

    <div id="exchangeLoadingIndicator" class="text-center py-5" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3">Loading exchanges...</p>
    </div>

    <div class="exchange-table-desktop" id="exchangeTableDesktop">
        <div class="table-responsive shadow-sm">
            <table class="table table-striped table-hover table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Txn No</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Currency</th>
                        <th class="text-end">Rate</th>
                        <th class="text-end">Foreign Amount</th>
                        <th class="text-end">LKR Amount<br /><span>Σ <span id="exchangeTotalLkr">LKR 0.00</span></span></th>
                        <th>Remarks</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody id="exchangeTableBody">
                </tbody>
            </table>
        </div>
    </div>

    <div class="exchange-table-mobile" id="exchangeTableMobile">
    </div>

    <div id="exchangePaginationContainer" class="mt-3"></div>
</div>

@Html.AntiForgeryToken()
<input type="hidden" id="isAdminFlag" data-is-admin="@isAdmin" />

<script src="~/js/period-date-filter.js?v=@Configuration["Assets:Version"]"></script>
<script src="~/js/currency-exchange-index.js?v=@Configuration["Assets:Version"]"></script>
