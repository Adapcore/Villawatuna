@model HotelManagement.Models.Entities.CurrencyExchange

@{
    ViewData["Title"] = "View Currency Exchange";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var customerName = Model.Customer == null
        ? "-"
        : $"{Model.Customer.FirstName} {Model.Customer.LastName}".Trim();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">💱 Exchange - [ @Model.Id ]</h2>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">Currency Exchange Details</h5>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-3">
                    <div class="detail-label">Exchange Transaction No</div>
                    <div class="detail-value">#@Model.Id</div>
                </div>
                <div class="col-md-3">
                    <div class="detail-label">Exchange Date</div>
                    <div class="detail-value">@Model.Date.ToString("dd MMM yyyy")</div>
                </div>
                <div class="col-md-6">
                    <div class="detail-label">Customer</div>
                    <div class="detail-value">@customerName</div>
                </div>

                <div class="col-md-3">
                    <div class="detail-label">Foreign Currency</div>
                    <div class="detail-value">@Model.ForeignCurrency</div>
                </div>
                <div class="col-md-3">
                    <div class="detail-label">Exchange Rate (LKR)</div>
                    <div class="detail-value text-end">@Model.ExchangeRate.ToString("N4")</div>
                </div>
                <div class="col-md-3">
                    <div class="detail-label">Foreign Amount</div>
                    <div class="detail-value text-end">@Model.ForeignCurrency @Model.ForeignAmount.ToString("N2")</div>
                </div>
                <div class="col-md-3">
                    <div class="detail-label">LKR Amount</div>
                    <div class="detail-value text-end fw-bold">LKR @Model.LKRAmount.ToString("N2")</div>
                </div>

                <div class="col-12">
                    <div class="detail-label">Remarks</div>
                    <div class="detail-value remarks">@(string.IsNullOrWhiteSpace(Model.Remarks) ? "-" : Model.Remarks)</div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .detail-label {
        color: #6c757d;
        font-size: 0.875rem;
        font-weight: 600;
        margin-bottom: 0.35rem;
    }

    .detail-value {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        font-size: 1.1rem;
        min-height: 3rem;
        padding: 0.7rem 0.85rem;
    }

    .detail-value.remarks {
        min-height: 5rem;
        white-space: pre-wrap;
    }

    @@media (max-width: 576px) {
        h2 {
            font-size: 1.35rem;
        }
    }
</style>
