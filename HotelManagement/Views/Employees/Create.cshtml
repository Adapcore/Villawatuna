@model HotelManagement.Models.Entities.Employee

@{
    ViewData["Title"] = "Create Employee";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var showWorkingDaysOther = string.Equals(Model.WorkingDays, "Other", StringComparison.OrdinalIgnoreCase);
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">Create Employee</h2>
    </div>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- 1. Personal Information -->
        <div class="card mb-4">
            <div class="card-header fw-semibold">1. Personal Information</div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NameWithInitials" class="form-label"></label>
                        <input asp-for="NameWithInitials" class="form-control" />
                        <span asp-validation-for="NameWithInitials" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="NIC" class="form-label"></label>
                        <input asp-for="NIC" class="form-control" />
                        <span asp-validation-for="NIC" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DOB" class="form-label"></label>
                        <input asp-for="DOB" type="date" class="form-control" />
                        <span asp-validation-for="DOB" class="text-danger"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Gender" class="form-label"></label>
                        <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Gender>()">
                            <option value="">-- Select --</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="MaritalStatus" class="form-label"></label>
                        <select asp-for="MaritalStatus" class="form-select" asp-items="Html.GetEnumSelectList<MaritalStatus>()">
                            <option value="">-- Select --</option>
                        </select>
                        <span asp-validation-for="MaritalStatus" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="ContactNo" class="form-label"></label>
                        <input asp-for="ContactNo" class="form-control" />
                        <span asp-validation-for="ContactNo" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-0">
                    <div class="col-md-6">
                        <label asp-for="PermanentAddress" class="form-label"></label>
                        <textarea asp-for="PermanentAddress" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="PermanentAddress" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CurrentAddress" class="form-label"></label>
                        <textarea asp-for="CurrentAddress" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="CurrentAddress" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Emergency Contact Person -->
        <div class="card mb-4">
            <div class="card-header fw-semibold">2. Emergency Contact Person</div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="EmergencyContactName" class="form-label"></label>
                        <input asp-for="EmergencyContactName" class="form-control" />
                        <span asp-validation-for="EmergencyContactName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EmergencyContactRelationship" class="form-label"></label>
                        <input asp-for="EmergencyContactRelationship" class="form-control" />
                        <span asp-validation-for="EmergencyContactRelationship" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-0">
                    <div class="col-md-6">
                        <label asp-for="EmergencyContactMobile" class="form-label"></label>
                        <input asp-for="EmergencyContactMobile" class="form-control" />
                        <span asp-validation-for="EmergencyContactMobile" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EmergencyContactAddress" class="form-label"></label>
                        <textarea asp-for="EmergencyContactAddress" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="EmergencyContactAddress" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Employee Information -->
        <div class="card mb-4">
            <div class="card-header fw-semibold">3. Employee Information</div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="JobTitle" class="form-label"></label>
                        <input asp-for="JobTitle" class="form-control" />
                        <span asp-validation-for="JobTitle" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Department" class="form-label"></label>
                        <input asp-for="Department" class="form-control" />
                        <span asp-validation-for="Department" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="JoinedDate" class="form-label"></label>
                        <input asp-for="JoinedDate" type="date" class="form-control" />
                        <span asp-validation-for="JoinedDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="EmploymentType" class="form-label"></label>
                        <select asp-for="EmploymentType" class="form-select" asp-items="Html.GetEnumSelectList<EmploymentType>()">
                            <option value="">-- Select --</option>
                        </select>
                        <span asp-validation-for="EmploymentType" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AgreedSalary" class="form-label"></label>
                        <input asp-for="AgreedSalary" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="AgreedSalary" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="WorkingLocation" class="form-label"></label>
                        <input asp-for="WorkingLocation" class="form-control" />
                        <span asp-validation-for="WorkingLocation" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-0">
                    <div class="col-md-3">
                        <label asp-for="WorkingDays" class="form-label"></label>
                        <select asp-for="WorkingDays" class="form-select" id="WorkingDays">
                            <option value="">-- Select --</option>
                            <option value="5 Day">5 Day</option>
                            <option value="6 Day">6 Day</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="WorkingDays" class="text-danger"></span>
                    </div>
                    <div class="col-md-3" id="WorkingDaysOtherGroup" style="@(showWorkingDaysOther ? null : "display:none")">
                        <label asp-for="WorkingDaysOther" class="form-label"></label>
                        <input asp-for="WorkingDaysOther" class="form-control" />
                        <span asp-validation-for="WorkingDaysOther" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="WorkingHours" class="form-label"></label>
                        <input asp-for="WorkingHours" class="form-control" placeholder="e.g. 08:00 - 17:00" />
                        <span asp-validation-for="WorkingHours" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="EPFNo" class="form-label"></label>
                        <input asp-for="EPFNo" class="form-control" />
                        <span asp-validation-for="EPFNo" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Bank Account Details -->
        <div class="card mb-4">
            <div class="card-header fw-semibold">4. Bank Account Details</div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="BankAccountHolderName" class="form-label"></label>
                        <input asp-for="BankAccountHolderName" class="form-control" />
                        <span asp-validation-for="BankAccountHolderName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BankName" class="form-label"></label>
                        <input asp-for="BankName" class="form-control" />
                        <span asp-validation-for="BankName" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-0">
                    <div class="col-md-6">
                        <label asp-for="BankBranchName" class="form-label"></label>
                        <input asp-for="BankBranchName" class="form-control" />
                        <span asp-validation-for="BankBranchName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BankAccountNumber" class="form-label"></label>
                        <input asp-for="BankAccountNumber" class="form-control" />
                        <span asp-validation-for="BankAccountNumber" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-success me-2">Save</button>
        <a class="btn btn-secondary" href="@Url.Action("Index", "Employees")">Cancel</a>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            var select = document.getElementById('WorkingDays');
            var group = document.getElementById('WorkingDaysOtherGroup');
            if (!select || !group) return;
            function toggle() {
                group.style.display = select.value === 'Other' ? '' : 'none';
            }
            select.addEventListener('change', toggle);
            toggle();
        })();
    </script>
}
