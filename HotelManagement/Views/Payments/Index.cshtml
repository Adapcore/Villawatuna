@using HotelManagement.Helper
@{
    ViewData["Title"] = "Payments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/period-date-filter.css?v=@Configuration["Assets:Version"]" />
<link rel="stylesheet" href="~/css/payments-index.css?v=@Configuration["Assets:Version"]" />

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">💲Payments</h2>
    </div>

    <!-- Filters -->
    <div class="card mb-3">
        <div class="card-body p-3">
            <form id="paymentFilterForm">
                <div class="row g-3 align-items-end" id="paymentDateFilter">
                    <div class="col-md-3 col-sm-6 pf-date-col pf-period d-none">
                        <label class="form-label fw-bold pf-field-label">Date</label>
                        <div class="input-group input-group-sm pf-stepper">
                            <button type="button" class="btn btn-outline-secondary pf-prev" aria-label="Previous">&lt;</button>
                            <div class="pf-period-center">
                            <div class="pf-popup-picker pf-day-picker pf-visible-picker">
                                <button type="button" class="form-control form-control-sm pf-display pf-day-display" aria-haspopup="dialog"><span class="pf-value">Today</span><i class="bi bi-calendar3" aria-hidden="true"></i></button>
                                <div class="pf-panel pf-day-panel d-none" role="dialog" aria-label="Choose date">
                                    <div class="pf-panel-nav">
                                        <button type="button" class="btn btn-outline-secondary btn-sm pf-day-month-prev" aria-label="Previous month">&lt;</button>
                                        <span class="pf-day-month-label"></span>
                                        <button type="button" class="btn btn-outline-secondary btn-sm pf-day-month-next" aria-label="Next month">&gt;</button>
                                    </div>
                                    <div class="pf-day-weekdays" aria-hidden="true">
                                        <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
                                    </div>
                                    <div class="pf-day-grid"></div>
                                    <button type="button" class="pf-day-today">Today</button>
                                </div>
                            </div>
                            <div class="pf-popup-picker pf-month-picker pf-visible-picker d-none">
                                <button type="button" class="form-control form-control-sm pf-display pf-month-display" aria-haspopup="dialog"><span class="pf-value">November 2026</span><i class="bi bi-calendar3" aria-hidden="true"></i></button>
                                <div class="pf-panel pf-month-panel d-none" role="dialog" aria-label="Choose month">
                                    <div class="pf-panel-nav">
                                        <button type="button" class="btn btn-outline-secondary btn-sm pf-month-year-prev" aria-label="Previous year">&lt;</button>
                                        <span class="pf-month-year-label"></span>
                                        <button type="button" class="btn btn-outline-secondary btn-sm pf-month-year-next" aria-label="Next year">&gt;</button>
                                    </div>
                                    <div class="pf-month-grid"></div>
                                </div>
                            </div>
                            <div class="pf-popup-picker pf-year-picker pf-visible-picker d-none">
                                <button type="button" class="form-control form-control-sm pf-display pf-year-display" aria-haspopup="dialog"><span class="pf-value">2026</span><i class="bi bi-calendar3" aria-hidden="true"></i></button>
                                <div class="pf-panel pf-year-panel d-none" role="dialog" aria-label="Choose year">
                                    <div class="pf-panel-nav">
                                        <button type="button" class="btn btn-outline-secondary btn-sm pf-year-page-prev" aria-label="Earlier years">&lt;</button>
                                        <span class="pf-year-page-label"></span>
                                        <button type="button" class="btn btn-outline-secondary btn-sm pf-year-page-next" aria-label="Later years">&gt;</button>
                                    </div>
                                    <div class="pf-year-grid"></div>
                                </div>
                            </div>
                            </div>
                            <button type="button" class="btn btn-outline-secondary pf-next" aria-label="Next">&gt;</button>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6 pf-date-col pf-from-wrap">
                        <label class="form-label fw-bold">From Date</label>
                        <div class="pf-date-field">
                            <input type="date" name="fromDate" class="form-control form-control-sm pf-from" />
                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6 pf-date-col pf-to-wrap">
                        <label class="form-label fw-bold">To Date</label>
                        <div class="pf-date-field">
                            <input type="date" name="toDate" class="form-control form-control-sm pf-to" />
                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                        </div>
                    </div>
                    <div class="col-md-2 col-sm-4">
                        <label class="form-label fw-bold">Type</label>
                        <select name="type" id="paymentType" class="form-select form-select-sm" asp-items="ViewBag.PaymentTypes">
                            <option value="">-- All --</option>
                        </select>
                    </div>
                    <div class="col-auto pf-mode-buttons">
                        <div class="d-flex gap-1 flex-wrap">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-range="daily">Daily</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-range="weekly">Weekly</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-range="monthly">Monthly</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-range="yearly">Yearly</button>
                            <button type="button" class="btn btn-primary btn-sm" data-range="range">Date Range</button>
                            <button type="button" class="btn btn-outline-dark btn-sm" id="btnPaymentClear">Clear</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Loading Indicator -->
    <div id="paymentLoadingIndicator" class="text-center py-5" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3">Loading payments...</p>
    </div>

    <!-- Desktop Table -->
    <div class="payments-table-desktop" id="paymentTableDesktop">
        <div class="table-responsive shadow-sm">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Payment ID</th>
                        <th>Date</th>
                        <th>Invoice No</th>
                        <th>Type</th>
                        <th>Reference</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody id="paymentTableBody">
                    <!-- Content loaded via AJAX -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobile Card Layout -->
    <div class="payments-table-mobile" id="paymentTableMobile">
        <!-- Content loaded via AJAX -->
    </div>

    <!-- Pagination Container -->
    <div id="paymentPaginationContainer"></div>
</div>

<script src="~/js/period-date-filter.js" asp-append-version="true"></script>
<script src="~/js/payments-index.js" asp-append-version="true"></script>