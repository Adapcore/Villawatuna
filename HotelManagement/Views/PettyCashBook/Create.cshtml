@model HotelManagement.Models.Entities.PettyCashBook
@using Microsoft.AspNetCore.Mvc.Rendering
@using HotelManagement.Enums
@{
    bool isApproved = Model.Id > 0 && Model.Status == PettyCashStatus.Approved;
    bool isViewMode = (ViewBag.IsViewMode != null && (bool)ViewBag.IsViewMode) || isApproved;
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;
    bool isEdit = Model.Id > 0 && !isViewMode;
    ViewData["Title"] = isViewMode
        ? "View Petty Cash Entry"
        : (Model.Id == 0 ? "New Petty Cash Entry" : "Edit Petty Cash Entry");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currencies = ViewBag.Currencies as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var currencyCodes = (ViewBag.CurrencyCodes as IEnumerable<string>)?.ToList() ?? new List<string> { "LKR", "USD", "GBP", "EUR" };
    bool hasEntryDate = isEdit || isViewMode || (ViewBag.HasEntryDate != null && (bool)ViewBag.HasEntryDate);
    string Fmt(decimal value) => value.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-US"));
    string statusBadgeClass = isApproved ? "bg-success" : "bg-warning text-dark";
    string statusLabel = Model.Id > 0 ? Model.Status.ToString() : PettyCashStatus.Open.ToString();
}

<link rel="stylesheet" href="~/css/petty-cash-book.css?v=@Configuration["Assets:Version"]" />

<div class="container-fluid py-4@(isViewMode ? " pcb-view-mode" : "")">
    <div class="petty-cash-page-header">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <h2 class="fw-bold text-primary mb-0">📅 Daily Cash Summary</h2>
            @if (Model.Id > 0)
            {
                <span class="badge @statusBadgeClass pcb-status-badge">@statusLabel</span>
            }
        </div>
        <div class="petty-cash-header-actions">
            <div class="petty-cash-title-date-field">
                <label class="form-label fw-bold mb-0" for="entryDate">Date</label>
                <input type="date" id="entryDate" class="form-control petty-cash-title-date-input"
                       value="@(hasEntryDate ? Model.Date.ToString("yyyy-MM-dd") : "")"
                       @(isEdit || isViewMode ? "readonly" : "") />
            </div>
            @if (isViewMode && !isApproved)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-pencil"></i> Edit
                </a>
            }
            @if (isViewMode && isAdmin && !isApproved)
            {
                <button type="button" id="btnApprovePettyCash" class="btn btn-success" data-id="@Model.Id">
                    <i class="bi bi-check2-circle"></i> Approve
                </button>
            }
            @if (isViewMode && isAdmin && isApproved)
            {
                <button type="button" id="btnReopenPettyCash" class="btn btn-warning" data-id="@Model.Id">
                    <i class="bi bi-unlock"></i> Reopen
                </button>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>
    <div id="dateWarning" class="text-danger small mb-3" style="display:none;"></div>

    <div class="card shadow-sm petty-cash-form-card">
        <div class="card-body p-4">
            <input type="hidden" id="entryId" value="@Model.Id" />
            <input type="hidden" id="isEdit" value="@(isEdit ? "true" : "false")" />
            <input type="hidden" id="isViewMode" value="@(isViewMode ? "true" : "false")" />
            <input type="hidden" id="openingBalance"
                   value="@(hasEntryDate ? Model.OpeningBalance.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "0.00")" />
            <input type="hidden" id="openingBalanceDisplay" value="@(hasEntryDate ? Fmt(Model.OpeningBalance) : "0.00")" />

            <div class="row g-4">
                <!-- Income -->
                <div class="col-lg-6 col-12 petty-cash-panel">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="mb-0 text-success fw-bold">Income (Cash)</h5>
                        @if (!isViewMode)
                        {
                            <button type="button" id="btnRefreshIncome" class="btn btn-sm btn-outline-success" title="Reload cash payments">
                                <i class="bi bi-arrow-clockwise"></i> Refresh
                            </button>
                        }
                    </div>
                    <div class="table-responsive petty-cash-table-scroll">
                        <table class="table table-sm table-bordered align-middle" id="incomeTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:@(isViewMode ? "60%" : "52%")">Title</th>
                                    <th class="petty-cash-currency-col">Currency</th>
                                    <th style="width:24%" class="text-end">Amount</th>
                                    @if (!isViewMode)
                                    {
                                        <th class="petty-cash-action-col"></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Income == null || Model.Income.Count == 0)
                                {
                                    <tr class="income-empty-row">
                                        <td colspan="@(isViewMode ? 3 : 4)" class="text-center text-muted py-3">No cash payments for this date.</td>
                                    </tr>
                                }
                                else
                                {
                                    @for (int i = 0; i < Model.Income.Count; i++)
                                    {
                                        var line = Model.Income[i];
                                        var typeCode = (line.InvoiceTypeCode ?? string.Empty).Trim();
                                        if (string.IsNullOrEmpty(typeCode) && !string.IsNullOrWhiteSpace(line.Title))
                                        {
                                            var parts = line.Title.Split(new[] { " - " }, StringSplitOptions.None);
                                            var last = parts.Length > 0 ? parts[^1].Trim() : string.Empty;
                                            typeCode = last switch
                                            {
                                                "Dining" => "Dining",
                                                "Take Away" => "TakeAway",
                                                "Stay" => "Stay",
                                                "Other" => "Other",
                                                "Tour" => "Tour",
                                                "Laundry" => "Laundry",
                                                _ => last.Replace(" ", string.Empty)
                                            };
                                        }
                                        var typeClass = string.IsNullOrEmpty(typeCode)
                                            ? string.Empty
                                            : "income-type-" + typeCode.ToLowerInvariant();
                                        <tr class="@typeClass"
                                            data-line-id="@line.Id"
                                            data-title="@line.Title"
                                            data-currency="@line.Currency"
                                            data-amount="@line.Amount.ToString("0.00")"
                                            data-invoice-type-code="@typeCode">
                                            <td><span class="income-title">@line.Title</span></td>
                                            <td class="text-center"><span class="income-currency">@line.Currency</span></td>
                                            <td class="text-end petty-cash-amount-cell" data-currency="@line.Currency">
                                                <span class="income-amount">@Fmt(line.Amount)</span>
                                            </td>
                                            @if (!isViewMode)
                                            {
                                                <td class="text-center petty-cash-line-action">
                                                    <button type="button" class="btn btn-sm btn-outline-danger pcb-remove-line" title="Remove line">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot>
                                <tr class="petty-cash-totals table-light">
                                    <td colspan="@(isViewMode ? 3 : 4)">
                                        <div class="d-flex justify-content-between flex-wrap gap-1 text-success fw-bold">
                                            <span>Total Income (LKR)</span>
                                            <span id="totalIncomeLkrDisplay">LKR @Fmt(Model.TotalIncomeBaseCurry)</span>
                                        </div>
                                        <div id="totalIncomeOtherCurrencies" class="petty-cash-other-currency-totals small text-muted mt-1">
                                            @{
                                                var otherIncomeTotals = (Model.TotalIncome ?? new List<HotelManagement.Models.Entities.PettyCashCurrencyTotal>())
                                                    .Where(t => !string.Equals(t.Currency, "LKR", StringComparison.OrdinalIgnoreCase))
                                                    .OrderBy(t => t.Currency)
                                                    .ToList();
                                            }
                                            @foreach (var t in otherIncomeTotals)
                                            {
                                                <div class="d-flex justify-content-between flex-wrap gap-1">
                                                    <span>Total Income (@t.Currency)</span>
                                                    <span>@t.Currency @Fmt(t.Total)</span>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Expenses -->
                <div class="col-lg-6 col-12 petty-cash-panel">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="mb-0 text-danger fw-bold">Expenses (Cash)</h5>
                        @if (!isViewMode)
                        {
                            <button type="button" id="btnRefreshExpenses" class="btn btn-sm btn-outline-danger" title="Reload cash expenses">
                                <i class="bi bi-arrow-clockwise"></i> Refresh
                            </button>
                        }
                    </div>
                    <div class="table-responsive petty-cash-table-scroll">
                        <table class="table table-sm table-bordered align-middle" id="expenseTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:@(isViewMode ? "60%" : "52%")">Title</th>
                                    <th class="petty-cash-currency-col">Currency</th>
                                    <th style="width:24%" class="text-end">Amount</th>
                                    @if (!isViewMode)
                                    {
                                        <th class="petty-cash-action-col"></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Expences == null || Model.Expences.Count == 0)
                                {
                                    <tr class="expense-empty-row">
                                        <td colspan="@(isViewMode ? 3 : 4)" class="text-center text-muted py-3">No cash expenses for this date.</td>
                                    </tr>
                                }
                                else
                                {
                                    @for (int i = 0; i < Model.Expences.Count; i++)
                                    {
                                        var line = Model.Expences[i];
                                        <tr data-line-id="@line.Id"
                                            data-title="@line.Title"
                                            data-currency="@line.Currency"
                                            data-amount="@line.Amount.ToString("0.00")">
                                            <td><span class="expense-title">@line.Title</span></td>
                                            <td class="text-center"><span class="expense-currency">@line.Currency</span></td>
                                            <td class="text-end petty-cash-amount-cell" data-currency="@line.Currency">
                                                <span class="expense-amount">@Fmt(line.Amount)</span>
                                            </td>
                                            @if (!isViewMode)
                                            {
                                                <td class="text-center petty-cash-line-action">
                                                    <button type="button" class="btn btn-sm btn-outline-danger pcb-remove-line" title="Remove line">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot>
                                <tr class="petty-cash-totals table-light">
                                    <td colspan="@(isViewMode ? 3 : 4)">
                                        <div class="d-flex justify-content-between flex-wrap gap-1 text-danger fw-bold">
                                            <span>Total Expenses (LKR)</span>
                                            <span id="totalExpensesLkrDisplay">LKR @Fmt(Model.TotalExpences)</span>
                                        </div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="row g-4 pcb-summary-grid">
                <div class="col-lg-6 col-12 petty-cash-summary">
                    <div class="summary-row fw-bold pcb-summary-opening">
                        <span><i class="bi bi-wallet2 me-1"></i>Petty Cash (Opening)</span>
                        <span class="pcb-amount">
                            <span class="pcb-ccy">LKR</span>
                            <span class="pcb-val" id="summaryOpening">@Fmt(Model.OpeningBalance)</span>
                        </span>
                    </div>
                    <div class="pcb-refill-block pcb-summary-refill-opening">
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle mb-1" id="refillTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Title</th>
                                        <th class="text-end" style="width:38%">Amount</th>
                                        @if (!isViewMode)
                                        {
                                            <th class="petty-cash-action-col text-center">
                                                <button type="button" id="btnAddRefill" class="btn btn-sm btn-outline-primary" title="Add refill">
                                                    <i class="bi bi-plus-lg"></i>
                                                </button>
                                            </th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var refillLines = Model.Refills ?? new List<HotelManagement.Models.Entities.PettyCashRefillLine>();
                                        var refillTotal = refillLines.Sum(r => r.Amount);
                                        if (refillTotal == 0)
                                            refillTotal = Model.PettyCashRefillOpening;
                                    }
                                    @if (refillLines.Count == 0)
                                    {
                                        <tr class="refill-empty-row">
                                            <td colspan="@(isViewMode ? 2 : 3)" class="text-center text-muted py-2">@(isViewMode ? "No refills." : "No refills. Click Add to enter one.")</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var line in refillLines)
                                        {
                                            <tr>
                                                @if (isViewMode)
                                                {
                                                    <td>@line.Title</td>
                                                    <td class="text-end">LKR @Fmt(line.Amount)</td>
                                                }
                                                else
                                                {
                                                    <td>
                                                        <input type="text" class="form-control form-control-sm refill-title" maxlength="250" value="@line.Title" placeholder="Title" />
                                                    </td>
                                                    <td>
                                                        <div class="input-group input-group-sm">
                                                            <span class="input-group-text">LKR</span>
                                                            <input type="number" class="form-control form-control-sm text-end refill-amount" step="0.01" min="0"
                                                                   value="@line.Amount.ToString("0.00")" />
                                                        </div>
                                                    </td>
                                                    <td class="text-center petty-cash-line-action">
                                                        <button type="button" class="btn btn-sm btn-outline-danger pcb-remove-refill" title="Remove refill">
                                                            <i class="bi bi-x-lg"></i>
                                                        </button>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="petty-cash-totals table-light">
                                        <td class="fw-bold">Petty Cash Refill (Opening)</td>
                                        <td class="text-end fw-bold" id="refillOpeningTotalDisplay">LKR @Fmt(refillTotal)</td>
                                        @if (!isViewMode)
                                        {
                                            <td></td>
                                        }
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                    <div class="summary-row fw-bold pcb-summary-balance">
                        <span>Petty Cash (Balance)</span>
                        <span class="pcb-amount">
                            <span class="pcb-ccy">LKR</span>
                            <span class="pcb-val js-summary-petty-cash-balance" id="summaryPettyCashBalance">@Fmt(Model.OpeningBalance + refillTotal)</span>
                        </span>
                    </div>
                </div>
                <div class="col-lg-6 col-12 petty-cash-summary">
                    <div class="summary-row fw-bold pcb-summary-balance pcb-summary-balance-dup">
                        <span>Petty Cash (Balance)</span>
                        <span class="pcb-amount">
                            <span class="pcb-ccy">LKR</span>
                            <span class="pcb-val js-summary-petty-cash-balance">@Fmt(Model.OpeningBalance + refillTotal)</span>
                        </span>
                    </div>
                    <div class="summary-row fw-bold text-success">
                        <span>➕ Income (LKR)</span>
                        <span class="pcb-amount">
                            <span class="pcb-ccy">LKR</span>
                            <span class="pcb-val" id="summaryIncome">@Fmt(Model.TotalIncomeBaseCurry)</span>
                        </span>
                    </div>
                    <div class="summary-row fw-bold text-danger">
                        <span>➖ Expenses</span>
                        <span class="pcb-amount">
                            <span class="pcb-ccy">LKR</span>
                            <span class="pcb-val" id="summaryExpenses">@Fmt(Model.TotalExpences)</span>
                        </span>
                    </div>
                    <div class="summary-row fw-bold pcb-summary-daily-balance">
                        <span>Daily Balance</span>
                        <span class="pcb-amount">
                            <span class="pcb-ccy">LKR</span>
                            <span class="pcb-val" id="summaryBalance">@Fmt(Model.Balance)</span>
                        </span>
                    </div>
                    <div class="summary-row">
                        <span class="fw-bold">🤝 Handed Over</span>
                        @if (isViewMode)
                        {
                            <span class="pcb-amount">
                                <span class="pcb-ccy">LKR</span>
                                <span class="pcb-val">@Fmt(Model.HandedOver)</span>
                            </span>
                        }
                        else
                        {
                            <div class="input-group">
                                <span class="input-group-text">LKR</span>
                                <input type="number" id="handedOver" class="form-control text-end" step="0.01" min="0"
                                       value="@Model.HandedOver.ToString("0.00")" />
                            </div>
                        }
                    </div>
                    <div class="summary-row pcb-summary-refill-closing">
                        <span class="fw-bold">Petty Cash Refill (Closing)</span>
                        @if (isViewMode)
                        {
                            <span class="pcb-amount">
                                <span class="pcb-ccy">LKR</span>
                                <span class="pcb-val">@Fmt(Model.PettyCashRefillClosing)</span>
                            </span>
                        }
                        else
                        {
                            <div class="input-group">
                                <span class="input-group-text">LKR</span>
                                <input type="number" id="pettyCashRefillClosing" class="form-control text-end" step="0.01" min="0"
                                       value="@Model.PettyCashRefillClosing.ToString("0.00")" />
                            </div>
                        }
                    </div>
                    <div class="summary-row fw-bold pcb-summary-closing">
                        <span><i class="bi bi-cash-stack me-1"></i>Petty Cash (Closing)</span>
                        <span class="pcb-amount">
                            <span class="pcb-ccy">LKR</span>
                            <span class="pcb-val" id="summaryCloseBalance">@Fmt(Model.ClosingBalance)</span>
                        </span>
                    </div>
                </div>
            </div>

            @if (!isViewMode)
            {
                <div class="petty-cash-actions mt-4">
                    <button type="button" id="btnSave" class="btn btn-primary btn-lg">
                        <i class="bi bi-save"></i> Save
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancel</a>
                </div>
            }
        </div>
    </div>
</div>

@if (!isViewMode)
{
    <script>
        window.pettyCashCurrencies = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currencyCodes));
    </script>
    <script src="~/js/petty-cash-book.js?v=@Configuration["Assets:Version"]"></script>
}
else
{
    @Html.AntiForgeryToken()
    <script src="~/js/petty-cash-book-details.js?v=@Configuration["Assets:Version"]"></script>
}
