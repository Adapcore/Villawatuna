@{
    ViewData["Title"] = "Petty Cash Book";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;
}

<link rel="stylesheet" href="~/css/petty-cash-book.css?v=@Configuration["Assets:Version"]" />

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 petty-cash-index-header">
        <h2 class="fw-bold text-primary mb-0">📅 Petty Cash Book</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> <span>Add Entry</span>
        </a>
    </div>

    <div class="card mb-4 petty-cash-filter-card">
        <div class="card-body">
            <form id="pettyCashFilterForm" class="row g-3">
                <div class="col-md-2 col-sm-6 col-6">
                    <label class="form-label fw-bold">From Date</label>
                    <input type="date" name="startDate" id="startDate" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2 col-sm-6 col-6">
                    <label class="form-label fw-bold">To Date</label>
                    <input type="date" name="endDate" id="endDate" class="form-control form-control-sm" />
                </div>
                <div class="col-md-8 col-12 d-flex align-items-end">
                    <div class="petty-cash-filter-buttons w-100">
                        <div class="d-flex gap-1 flex-wrap">
                            <button type="button" id="btnToday" class="btn btn-outline-secondary btn-sm">Today</button>
                            <button type="button" id="btnYesterday" class="btn btn-outline-secondary btn-sm">Yesterday</button>
                            <button type="button" id="btnMonth" class="btn btn-outline-secondary btn-sm">Month</button>
                            <button type="button" id="btnYear" class="btn btn-outline-secondary btn-sm">Year</button>
                            <button type="button" id="btnClear" class="btn btn-outline-dark btn-sm">Clear</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div id="pettyCashLoadingIndicator" class="text-center py-5" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3">Loading entries...</p>
    </div>

    <!-- Desktop table -->
    <div class="table-responsive shadow-sm petty-cash-table-desktop" id="pettyCashTableDesktop">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Date</th>
                    <th class="text-end">Opening</th>
                    <th class="text-end">Refill (Opening)</th>
                    <th class="text-end">Income (LKR)</th>
                    <th class="text-end">Expenses (LKR)</th>
                    <th class="text-end">Daily Balance</th>
                    <th class="text-end">Handed Over</th>
                    <th class="text-end">Refill (Closing)</th>
                    <th class="text-end">Closing Balance</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody id="pettyCashTableBody">
            </tbody>
        </table>
    </div>

    <!-- Mobile cards -->
    <div class="petty-cash-table-mobile" id="pettyCashTableMobile">
    </div>

    <div id="pettyCashPaginationContainer" class="mt-3"></div>
</div>

@Html.AntiForgeryToken()
<input type="hidden" id="isAdminFlag" data-is-admin="@isAdmin" />

<script src="~/js/petty-cash-book-index.js?v=@Configuration["Assets:Version"]"></script>
